process {

    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename == 'versions.yml' ? null : filename }
    ]

    withName: 'CHECK_MD5|PREPARE_REFERENCE' {
        publishDir = [ enabled: false ]
    }

    withName: 'DWGSIM' {
        // 2x150, ~300 bp outer distance, errors rising along each read.
        // -r 0: no added variants (HPRC haplotypes already differ from GRCh38/CHM13).
        // -y 0: no random-sequence reads. -o 1: per-end FASTQs only.
        ext.args   = '-1 150 -2 150 -d 300 -s 60 -e 0.001-0.01 -E 0.001-0.015 -r 0 -y 0 -H -c 0 -o 1'
        publishDir = [
            path:   { "${params.outdir}/illumina" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'PBSIM' {
        // Mean accuracy 0.95 with the HQ model; raise towards 0.98-0.99 to mimic R10.4.1 SUP.
        // Read length should reflect human reads in your real metagenomic runs.
        ext.args   = '--length-mean 5000 --length-sd 4000 --accuracy-mean 0.95'
        publishDir = [
            path:   { "${params.outdir}/ont" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
